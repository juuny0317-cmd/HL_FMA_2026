<?xml version="1.0"?>
<package format="3">
  <name>hl_ku_foxglove</name>
  <version>0.1.0</version>
  <description>Safe rosbag replay and Foxglove visualization for HL KU FMA.</description>
  <maintainer email="hl-ku@example.com">HL KU Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>hl_ku_core</exec_depend>
  <exec_depend>hl_ku_interfaces</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
